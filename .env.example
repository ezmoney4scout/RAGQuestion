# ======================================================================
# RAG 知识库问答系统 —— 环境变量模板
# ----------------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env    （cp .env.example .env）
#   2. 根据实际情况填写下方参数
#   3. 切勿将 .env 提交到 git 仓库！
# ======================================================================


# ==================== 模型提供方开关 ====================
# true  = 使用本地 Ollama 模型
# false = 使用 OpenAI 云端 API
USE_OLLAMA=false


# ==================== OpenAI 配置 ====================
# 仅在 USE_OLLAMA=false 时生效
OPENAI_API_KEY=sk-your-openai-api-key-here

# 可选模型：gpt-3.5-turbo / gpt-4 / gpt-4-turbo / gpt-4o-mini
MODEL_NAME=gpt-3.5-turbo

# Embedding 模型（OpenAI）
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ==================== Ollama 配置 ====================
# 仅在 USE_OLLAMA=true 时生效
# 需先本地启动 Ollama 服务：ollama serve
OLLAMA_BASE_URL=http://localhost:11434

# 对话模型（需先 ollama pull <model>）
# 常用：llama2 / llama3 / qwen / mistral / gemma
OLLAMA_MODEL=llama2

# Embedding 模型（需先 ollama pull nomic-embed-text）
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# ==================== RAG 运行参数 ====================
# 文档分块大小（字符数）
CHUNK_SIZE=1000

# 分块之间的重叠字符数，用于保留上下文
CHUNK_OVERLAP=200

# 检索时返回的文档片段数量
TOP_K=4

# 生成温度（0.0 = 严谨，1.0 = 创造）
TEMPERATURE=0.2

# 单次生成的最大 token 数
MAX_TOKENS=1024
